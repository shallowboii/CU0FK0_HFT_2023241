<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net5.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="musicasd.mdf" />
    <None Remove="musicasd_log.ldf" />
    <None Remove="MusicDB.mdf" />
    <None Remove="MusicDB_log.ldf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="musicasd.mdf">
