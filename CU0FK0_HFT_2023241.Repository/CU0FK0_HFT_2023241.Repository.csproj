      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CU0FK0_HFT_2023241.Models\CU0FK0_HFT_2023241.Models.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="MusicDB_log.ldf" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="xcopy /y &quot;$(ProjectDir)musicasd.mdf&quot; &quot;$(OutDir)\&quot;" />
  </Target>

</Project>
