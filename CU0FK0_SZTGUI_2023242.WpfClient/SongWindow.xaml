<Window x:Class="CU0FK0_SZTGUI_2023242.WpfClient.SongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CU0FK0_SZTGUI_2023242.WpfClient"
        xmlns:vms="clr-namespace:CU0FK0_SZTGUI_2023242.WpfClient.ViewModels"
        mc:Ignorable="d"
        Title="SongWindow" Height="450" Width="800">
    <Window.DataContext>
        <vms:SongWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <ListBox ItemsSource="{Binding Songs}" SelectedItem="{Binding SelectedSong}" Grid.Column="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Label Content="{Binding SongTitle}"></Label>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1">
            <Label Content="Name" Background="DarkTurquoise" Padding="10"></Label>
            <TextBox Text="{Binding SelectedSong.SongTitle}" Padding="10" Margin="0,0,0,30"></TextBox>
            <Button Content="Create Song" Command="{Binding CreateSongCommand}" Margin="10" Padding="10"></Button>
            <Button Content="Delete Song" Command="{Binding DeleteSongCommand}" Margin="10" Padding="10"></Button>
            <Button Content="Update Song" Command="{Binding UpdateSongCommand}" Margin="10" Padding="10"></Button>
            <Button Content="An Albums Best Song" Command="{Binding GetAnAlbumsBestSongCommand}" Margin="10" Padding="10"></Button>
            <Label Content="Selected Song's Album ID:"></Label>
            <TextBlock Text="{Binding SelectedSong.AlbumID}"></TextBlock>
            <TextBox Text="{Binding Result.SongTitle}" Padding="10"></TextBox>
        </StackPanel>
    </Grid>
</Window>
