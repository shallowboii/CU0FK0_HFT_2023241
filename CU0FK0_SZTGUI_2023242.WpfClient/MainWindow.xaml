<Window x:Class="CU0FK0_SZTGUI_2023242.WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CU0FK0_SZTGUI_2023242.WpfClient"
        xmlns:vms="clr-namespace:CU0FK0_SZTGUI_2023242.WpfClient.ViewModels"
        mc:Ignorable="d"
        Title="SongWindow" Height="450" Width="800">
    <Window.DataContext>
        <vms:MainWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Button Command="{Binding ArtistOpenerCommand}"  Background="AliceBlue" BorderThickness="5" FontSize="30" FontStretch="Condensed" FontWeight="Bold" Grid.Column="0">Artist</Button>
        <Button  Command="{Binding AlbumOpenerCommand}" Background="AliceBlue" BorderThickness="5" FontSize="30" FontStretch="Condensed" FontWeight="Bold" Grid.Column="1">Album</Button>
        <Button Command="{Binding SongOpenerCommand}" Background="AliceBlue" BorderThickness="5" FontSize="30" FontStretch="Condensed" FontWeight="Bold" Grid.Column="2">Song</Button>
    </Grid>
</Window>
