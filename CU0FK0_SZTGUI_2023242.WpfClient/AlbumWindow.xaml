<Window x:Class="CU0FK0_SZTGUI_2023242.WpfClient.AlbumWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CU0FK0_SZTGUI_2023242.WpfClient"
        xmlns:vms="clr-namespace:CU0FK0_SZTGUI_2023242.WpfClient.ViewModels"
        mc:Ignorable="d"
        Title="AlbumWindow" Height="450" Width="800">
    <Window.DataContext>
        <vms:AlbumWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <ListBox ItemsSource="{Binding Albums}" SelectedItem="{Binding SelectedAlbum}" Grid.Column="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Label Content="{Binding AlbumTitle}"></Label>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1">
            <Label Content="Name" Background="DarkTurquoise" Padding="10"></Label>
            <TextBox Text="{Binding SelectedAlbum.AlbumTitle}" Padding="10" Margin="0,0,0,30"></TextBox>
            <Button Content="Create Album" Command="{Binding CreateAlbumCommand}" Margin="10" Padding="10"></Button>
            <Button Content="Delete Album" Command="{Binding DeleteAlbumCommand}" Margin="10" Padding="10"></Button>
            <Button Content="Update Album" Command="{Binding UpdateAlbumCommand}" Margin="10" Padding="10"></Button>
        </StackPanel>
    </Grid>
</Window>
