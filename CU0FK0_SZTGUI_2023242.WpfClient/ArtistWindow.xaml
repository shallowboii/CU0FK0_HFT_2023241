<Window x:Class="CU0FK0_SZTGUI_2023242.WpfClient.ArtistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CU0FK0_SZTGUI_2023242.WpfClient"
        xmlns:vms="clr-namespace:CU0FK0_SZTGUI_2023242.WpfClient.ViewModels"
        mc:Ignorable="d"
        Title="ArtistWindow" Height="450" Width="800">
    <Window.DataContext>
        <vms:ArtistWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" Grid.Row="0" Content="Artist" Background="#1d3557" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="15" FontWeight="Black" Foreground="White"></Label>
        <ListBox ItemsSource="{Binding Artists}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" SelectedItem="{Binding SelectedArtist}" Grid.Column="0" Grid.Row="1" Background="#457b9d">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Label FontWeight="Black" Foreground="White" Content="{Binding ArtistName}"></Label>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Label Content="Name of the selected Artist" Padding="10" Grid.Column="4" Grid.Row="0" Background="#780000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="15" FontWeight="Black" Foreground="White"></Label>
        <StackPanel Grid.Column="4" Grid.Row="1" Background="OrangeRed" >
            <TextBox Text="{Binding SelectedArtist.ArtistName}" Padding="10" Margin="0,0,0,10" Background="#f1faee"></TextBox>
            <Button Foreground="White" Background="#e63946" BorderThickness="2" FontSize="15" Content="Create Artist" Command="{Binding CreateArtistCommand}" Margin="10" Padding="10"></Button>
            <Button Foreground="White" Background="#e63946" BorderThickness="2" FontSize="15" Content="Delete Artist" Command="{Binding DeleteArtistCommand}" Margin="10" Padding="10"></Button>
            <Button Foreground="White" Background="#e63946" BorderThickness="2" FontSize="15" Content="Update Artist" Command="{Binding UpdateArtistCommand}" Margin="10" Padding="10"></Button>
        </StackPanel>
    </Grid>
</Window>
