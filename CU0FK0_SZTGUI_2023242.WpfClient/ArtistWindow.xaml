<Window x:Class="CU0FK0_SZTGUI_2023242.WpfClient.ArtistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CU0FK0_SZTGUI_2023242.WpfClient"
        xmlns:vms="clr-namespace:CU0FK0_SZTGUI_2023242.WpfClient.ViewModels"
        mc:Ignorable="d"
        Title="ArtistWindow" Height="450" Width="800">
    <Window.DataContext>
        <vms:ArtistWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <ListBox ItemsSource="{Binding Artists}" SelectedItem="{Binding SelectedArtist}" Grid.Column="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Label Content="{Binding ArtistName}"></Label>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1">
            <Label Content="Name" Background="DarkTurquoise" Padding="10"></Label>
            <TextBox Text="{Binding SelectedArtist.ArtistName}" Padding="10" Margin="0,0,0,30"></TextBox>
            <Button Content="Create Artist" Command="{Binding CreateArtistCommand}" Margin="10" Padding="10"></Button>
            <Button Content="Delete Artist" Command="{Binding DeleteArtistCommand}" Margin="10" Padding="10"></Button>
            <Button Content="Update Artist" Command="{Binding UpdateArtistCommand}" Margin="10" Padding="10"></Button>
        </StackPanel>
    </Grid>
</Window>
